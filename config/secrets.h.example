/**
 * @file secrets.h.example
 * @brief Template for local credentials (Telemetry WiFi backend, Buddy 1).
 *
 * Copy to config/secrets.h (git-ignored) and fill in.  Only builds with
 * -DTEL_BACKEND_WIFI=ON read it; configure fails without it in that case.
 * Never commit config/secrets.h.
 */

#ifndef SECRETS_H
#define SECRETS_H

/** WiFi network name (2.4 GHz: the CYW43 has no 5 GHz radio). */
#define WIFI_SSID           "your-ssid"
/** WiFi password (WPA2). */
#define WIFI_PASSWORD       "your-password"
/** MQTT broker: an IPv4 address ("192.168.1.10") or a host name. */
#define MQTT_BROKER_HOST    "192.168.1.10"
/** MQTT broker TCP port (1883 = plain MQTT). */
#define MQTT_BROKER_PORT    (1883U)

/* Optional (defaults in app_program/subsystem1/drv_wifi.c):
 * #define MQTT_CLIENT_ID   "robocar-is16"
 * #define MQTT_USER        "user"            (default: anonymous)
 * #define MQTT_PASS        "password"
 * #define WIFI_COUNTRY     CYW43_COUNTRY_SINGAPORE
 * #define WIFI_AUTH        CYW43_AUTH_WPA2_AES_PSK
 */

#endif /* SECRETS_H */
